{
  "name": "default",
  "description": "Standard layout - badge + title + body/image + subtitle bar; modes block defines chapter/flow narrative presets",
  "version": "1.2.0",
  "modes": {
    "chapter": {
      "numbered": true,
      "openingPreview": "agenda",
      "closingRecap": true,
      "transition": "wipe",
      "verticalOpeningCover": false
    },
    "flow": {
      "numbered": false,
      "openingPreview": "chips",
      "closingRecap": false,
      "transition": "crossfade",
      "verticalOpeningCover": true
    }
  },
  "layout": {
    "landscape": {
      "badge": {
        "top": 60,
        "left": 80,
        "size": 110,
        "fontSize": 54
      },
      "title": {
        "leftWithBadge": 205,
        "leftWithoutBadge": 0,
        "topNews": 80,
        "topOther": "10%",
        "fontSizeNews": 84,
        "fontSizeNewsImage": 72,
        "fontSizeOther": 106,
        "padding": "0 100px",
        "rightInset": 110
      },
      "body": {
        "fontSize": 38,
        "marginTop": 24,
        "padding": "24px 30px",
        "lineHeight": 1.55,
        "maxWidth": 910,
        "top": 368,
        "leftMargin": 50,
        "sideGap": 25,
        "titleGap": 50,
        "card": true
      },
      "tagline": {
        "fontSize": 44,
        "marginTop": 16,
        "lineHeight": 1.4,
        "indent": 24
      },
      "image": {
        "width": 910,
        "height": 644,
        "top": 540,
        "right": 25,
        "glow": 40
      },
      "subtitle": {
        "height": 176,
        "fontSize": 46,
        "padding": "0 50px",
        "maxWidth": 1600
      },
      "agenda": {
        "fontSize": 46,
        "numSize": 60,
        "gap": 20,
        "marginTop": 56,
        "indentLeft": 140,
        "minFont": 32,
        "shrinkThreshold": 6,
        "shrinkMax": 8,
        "itemGap": 14,
        "maxItems": 7
      },
      "chip": {
        "fontSize": 38,
        "padding": "14px 28px",
        "marginTop": 96,
        "gap": 16
      },
      "progressBar": {
        "height": 4
      },
      "accentBar": {
        "width": 6
      },
      "grid": {
        "size": 60
      }
    },
    "vertical": {
      "segCard": {
        "padding": "62px 50px 50px"
      },
      "verse": {
        "windowHeight": 350,
        "clipPad": 60,
        "linePad": 5
      },
      "badge": {
        "top": 60,
        "left": 80,
        "size": 90,
        "fontSize": 42
      },
      "title": {
        "leftWithBadge": 200,
        "leftWithoutBadge": 0,
        "topNews": 80,
        "topOther": "14%",
        "fontSizeNews": 76,
        "fontSizeNewsImage": 72,
        "fontSizeOther": 88,
        "padding": "60px 80px",
        "rightInset": 60
      },
      "body": {
        "fontSize": 38,
        "marginTop": 24,
        "padding": "24px 28px",
        "lineHeight": 1.55,
        "maxWidth": 760,
        "card": true
      },
      "tagline": {
        "fontSize": 36,
        "marginTop": 14
      },
      "image": {
        "width": 980,
        "height": 980,
        "top": "auto",
        "centerHorizontal": true,
        "aspect": "1.4142/1",
        "marginTop": 45,
        "borderRadius": 16,
        "marginSide": 25
      },
      "subtitle": {
        "height": 216,
        "fontSize": 40,
        "padding": "0 60px",
        "maxWidth": 900
      },
      "agenda": {
        "fontSize": 40,
        "numSize": 52,
        "gap": 30,
        "marginTop": 95,
        "indentLeft": 52,
        "minFont": 32,
        "shrinkThreshold": 8,
        "shrinkMax": 8,
        "lineHeight": 1.34,
        "itemGap": 14,
        "maxItems": 7
      },
      "chip": {
        "fontSize": 34,
        "padding": "12px 24px",
        "marginTop": 84,
        "gap": 16
      },
      "progressBar": {
        "height": 4
      },
      "accentBar": {
        "width": 6
      },
      "grid": {
        "size": 60
      }
    }
  },
  "animation": {
    "titleEntrance": {
      "type": "scale",
      "from": 0.5,
      "duration": 0.5,
      "ease": "back.out(1.7)"
    },
    "badgeEntrance": {
      "type": "scale",
      "from": 0,
      "duration": 0.4,
      "ease": "back.out(2)"
    },
    "taglineEntrance": {
      "y": 20,
      "duration": 0.5,
      "delay": 0.3
    },
    "bodyLineStagger": {
      "delay": 0.15,
      "x": -20,
      "duration": 0.4,
      "startDelay": 0.6
    },
    "accentBar": {
      "duration": 0.5,
      "ease": "power2.out"
    },
    "glowPulse": {
      "duration": 0.8
    },
    "glowBreath": {
      "period": 1.6,
      "min": 0.85
    },
    "numPop": {
      "duration": 0.18,
      "scale": 1.12
    },
    "transitionWipe": {
      "duration": 0.4,
      "ease": "power2.inOut"
    },
    "segmentFadeIn": {
      "duration": 0.3,
      "ease": "power2.out"
    },
    "segmentFadeOut": {
      "duration": 0.3,
      "ease": "power2.in"
    },
    "firstSegmentFadeIn": {
      "duration": 0.4
    },
    "imageEntrance": {
      "x": 60,
      "duration": 0.8,
      "ease": "power2.out",
      "startDelay": 0.2
    },
    "agendaStagger": {
      "delay": 0.12,
      "x": -30,
      "duration": 0.4,
      "ease": "power2.out",
      "startDelay": 0.6
    },
    "chipStagger": {
      "delay": 0.1,
      "scaleFrom": 0.8,
      "duration": 0.35,
      "ease": "back.out(1.8)",
      "startDelay": 0.6
    }
  },
  "typography": {
    "fontFamily": "\"Microsoft YaHei\", \"PingFang SC\", \"Noto Sans SC\", sans-serif",
    "titleWeight": 900,
    "taglineWeight": 600,
    "bodyWeight": 400,
    "titleLineHeight": 1.25,
    "badgeWeight": 900,
    "bodyLineGap": 12,
    "bodyBorderRadius": 16,
    "bodyBorderLeft": 4,
    "imageBorderRadius": 24
  },
  "subtitle": {
    "_meta": "字幕切分参数（_script_utils.subtitle_params_for 消费）。maxChars=单行目标宽度（字符，按画幅物理宽度/字号推导：竖屏 980px/40px≈22 字、横屏 870px/46px≈28 字）；hardCap=次要标点切不动时的字符级硬切上限；cueMaxLines=每屏行数（bar 模式 ≤2 防盖正文卡，verse 整句渲染故 99）。",
    "landscape": { "maxChars": 28, "hardCap": 34, "cueMaxLines": 2 },
    "vertical": { "maxChars": 22, "hardCap": 22, "cueMaxLines": 99 }
  },
  "speaker": {
    "_meta": "双人对话说话人配色（gen_hyperframes 消费，selftest [21] 做 WCAG 对比度断言）。colorsOnLight=浅字幕栏（cream）配深色系、colorsOnDark=深字幕栏（dark）配浅色系，运行时按字幕栏明暗二选一、按说话人顺序循环取色；agendaNumText=agenda 序号圆数字色（叠在各段 accent 圆底上，对 8 色板对比度 5.5-13.8）。改色后跑 selftest 验证对比度。",
    "colorsOnLight": ["#1d4ed8", "#b45309", "#047857", "#7c3aed", "#be123c", "#0e7490"],
    "colorsOnDark": ["#7dd3fc", "#fbbf24", "#6ee7b7", "#c4b5fd", "#fda4af", "#67e8f9"],
    "agendaNumText": "#0a0e14"
  }
}